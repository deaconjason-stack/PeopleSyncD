{
  "Api": {
    "Name": "PeopleSyncD API"
  },
  "Database": {
    "Provider": "PostgreSql",
    "ApplyMigrationsOnStartup": false
  },
  "ConnectionStrings": {
    "peoplesyncd": ""
  },
  "Jwt": {
    "Issuer": "PeopleSyncD",
    "Audience": "PeopleSyncD.Clients",
    "AccessTokenMinutes": 15
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "AllowedHosts": "*"
}
