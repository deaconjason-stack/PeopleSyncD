  "supportingIndexes": [
    "architecture/README.md",
    "diagrams/README.md",
    "decisions/README.md",
    "examples/README.md",
    "code/README.md"
  ],
  "traceability": {
    "registry": "docs/traceability/master-lifecycle.csv",
    "chain": [
      "vision",
      "business-goal",
      "product-epic",
      "feature",
      "requirement",
      "architecture-decision",
      "specification",
      "service",
      "api-event-data-contract",
      "code",
      "test",
      "release-evidence",
      "customer-documentation",
      "customer-feedback"
    ]
  },
  "maturityPhases": [
    {"id": "foundation", "objective": "governed repository architecture standards and core service foundations"},
    {"id": "mvp", "objective": "authentication tenancy organizations HR core and initial governed assistant"},
    {"id": "enterprise", "objective": "security integrations reporting administration and resilience"},
    {"id": "platform", "objective": "SDK marketplace partner ecosystem and advanced analytics"},
    {"id": "global", "objective": "multi-region localization residency and compliance expansion"},
    {"id": "intelligence", "objective": "advanced agents predictive analytics and workflow orchestration"}
