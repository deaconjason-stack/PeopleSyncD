NODE_ENV=production
PEOPLESYNCD_API_HOST=0.0.0.0
PEOPLESYNCD_API_PORT=8080
PEOPLESYNCD_CORS_ORIGIN=https://replace-with-approved-origin.example
PEOPLESYNCD_STORAGE=postgres
PEOPLESYNCD_DATABASE_URL=secret://database/peoplesyncd-runtime
PEOPLESYNCD_MIGRATION_DATABASE_URL=secret://database/peoplesyncd-migration
PEOPLESYNCD_SESSION_SECRET=secret://identity/session-signing-secret
PEOPLESYNCD_DEV_AUTH=false
# Reserved for a later validated provider integration; not active in Phase 7B1.
PEOPLESYNCD_OIDC_ISSUER=not-configured
PEOPLESYNCD_OIDC_CLIENT_ID=not-configured
