NODE_ENV=development
PEOPLESYNCD_API_HOST=127.0.0.1
PEOPLESYNCD_API_PORT=8080
PEOPLESYNCD_STORAGE=postgres
PEOPLESYNCD_DATABASE_URL=postgresql://peoplesyncd_migrator:replace-me@127.0.0.1:5432/peoplesyncd
PEOPLESYNCD_SESSION_SECRET=replace-with-at-least-32-random-characters
PEOPLESYNCD_MFA_ENCRYPTION_KEY=replace-with-a-different-at-least-32-character-key
PEOPLESYNCD_DEV_AUTH=true
PEOPLESYNCD_CORS_ORIGIN=http://localhost:5173

# Production requirements:
# - NODE_ENV=production
# - PEOPLESYNCD_DEV_AUTH=false
# - use independently managed session and MFA keys
# - use separate migration and constrained runtime database credentials
# - do not store real secrets in repository files
