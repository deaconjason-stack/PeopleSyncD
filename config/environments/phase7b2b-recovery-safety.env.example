NODE_ENV=production
PEOPLESYNCD_API_HOST=0.0.0.0
PEOPLESYNCD_API_PORT=8080
PEOPLESYNCD_STORAGE=postgres
PEOPLESYNCD_DATABASE_ROLE_MODE=direct
PEOPLESYNCD_RUNTIME_DATABASE_URL=postgresql://peoplesyncd_app:replace-from-secret-manager@database.example:5432/peoplesyncd
PEOPLESYNCD_SESSION_SECRET=replace-from-approved-secret-manager
PEOPLESYNCD_MFA_ENCRYPTION_KEY=replace-with-an-independent-approved-key
PEOPLESYNCD_DEV_AUTH=false
PEOPLESYNCD_CORS_ORIGIN=https://peoplesyncd.example

# Migration tooling must use a separate migration-authorized credential.
# Never expose the migration credential to the API or desktop runtime.
# Provision the application login with scripts/database/provision_runtime_login.sql.
# Store all real values only in the approved deployment secret manager.
