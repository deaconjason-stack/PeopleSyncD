COMPOSE_PROJECT_NAME=peoplesyncd-genesis
POSTGRES_IMAGE=postgres:16-alpine
POSTGRES_DB=peoplesyncd
POSTGRES_USER=peoplesyncd_local
POSTGRES_PASSWORD=local-development-only-change-me
